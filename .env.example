# CampusFlow cloud configuration
# Copy this file to .env for local testing.
# Never commit your real .env file.

NODE_ENV=development

# Supabase PostgreSQL connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://YOUR_CONNECTION_STRING

# Supabase project URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only secret.
# Supabase Dashboard -> Settings -> API Keys -> Secret key
# Use the current sb_secret_... key format.
# NEVER place this value in browser JavaScript.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# CampusFlow automatically creates this private bucket if it does not exist.
SUPABASE_STORAGE_BUCKET=campusflow-materials
